{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha Premier ID Maker",
  "mainBinaryName": "Alpha Premier ID Maker",
  "version": "1.21.0",
  "identifier": "com.alphapremiergroup.idmaker",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node sync-web.mjs",
    "beforeDevCommand": "node sync-web.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Alpha Premier Group of Companies",
    "copyright": "Alpha Premier Group of Companies",
    "shortDescription": "Employee ID card maker",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "PUBLIC-KEY-GOES-HERE",
      "endpoints": [
        "https://github.com/azure-cj/apg-id-creator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
