<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the SDK on the laptop that builds this. A framework-dependent app
         does not roll forward across a major version on its own, so
         targeting 8 and running on 10 fails at startup with "you must
         install .NET 8". Change this to match the SDK on the machine
         that builds it, as reported by the dotnet version command. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <AssemblyName>Alpha Premier ID Maker</AssemblyName>
    <RootNamespace>AlphaPremier.IdMaker</RootNamespace>
    <Company>Alpha Premier Group of Companies</Company>
    <Product>Alpha Premier ID Maker</Product>
    <!-- keep in step with APP_VERSION in src/config.js -->
    <Version>1.9.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- floating on purpose: an exact version that happens not to exist
         fails the restore outright, and any 1.0.x has the API used here -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <!-- the whole app is one file; it ships beside the exe, under web/ so
       the shell can serve that folder under a host name -->
  <ItemGroup>
    <None Include="..\..\Alpha Premier ID Maker.html" Link="web\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- the exe carries this for Explorer; the copy is what the window
         itself loads at run time -->
    <None Include="..\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
