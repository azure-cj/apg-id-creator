<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <AssemblyName>Alpha Premier ID Maker</AssemblyName>
    <RootNamespace>AlphaPremier.IdMaker</RootNamespace>
    <Company>Alpha Premier Group of Companies</Company>
    <Product>Alpha Premier ID Maker</Product>
    <!-- keep in step with APP_VERSION in src/config.js -->
    <Version>1.9.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- the whole app is one file; it ships beside the exe, under web/ so
       the shell can serve that folder under a host name -->
  <ItemGroup>
    <None Include="..\..\Alpha Premier ID Maker.html" Link="web\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- the exe carries this for Explorer; the copy is what the window
         itself loads at run time -->
    <None Include="..\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
