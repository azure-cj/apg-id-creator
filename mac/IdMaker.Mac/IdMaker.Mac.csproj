<Project Sdk="Microsoft.NET.Sdk">

  <!-- The native Mac app: C# on Apple's own AppKit, no web view. It shares
       every rule with the Windows app through IdMaker.Core, so a card, a
       number and the register behave the same on both. -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>IdMaker.Mac</RootNamespace>
    <AssemblyName>AlphaPremierIdMaker</AssemblyName>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <ApplicationTitle>Alpha Premier ID Maker</ApplicationTitle>
    <ApplicationId>com.alphapremiergroup.idmaker</ApplicationId>
    <!-- Kept equal to the Windows app's version and CardConfig.AppVersion. -->
    <Version>2.0.4</Version>
    <ApplicationDisplayVersion>2.0.4</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Nothing is trimmed out of the app: Core reads and writes its files and the register's answers by
         reflection (System.Text.Json), and what was tested is what should ship. The cost is a larger download. -->
    <LinkMode>None</LinkMode>
    <!-- .NET's own messages in words ("Could not find a part of the path…"), not their internal names: some reach the operator. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\windows\IdMaker.Core\IdMaker.Core.csproj" />
    <!-- Background removal: ONNX Runtime (the one package, as on Windows) and the model it fetches and checks. -->
    <ProjectReference Include="..\..\windows\IdMaker.Vision\IdMaker.Vision.csproj" />
  </ItemGroup>

  <!-- What the app carries: the card's artwork, the card's fonts and the
       model, the same files the Windows app is built with. -->
  <ItemGroup>
    <BundleResource Include="..\..\assets\front-template.png" LogicalName="Assets/front-template.png" />
    <BundleResource Include="..\..\assets\back.png" LogicalName="Assets/back.png" />
    <BundleResource Include="..\..\assets\logo.png" LogicalName="Assets/logo.png" />
    <BundleResource Include="..\..\windows\IdMaker.App\Fonts\Arimo-Regular.ttf" LogicalName="Fonts/Arimo-Regular.ttf" />
    <BundleResource Include="..\..\windows\IdMaker.App\Fonts\Montserrat-ExtraBold.ttf" LogicalName="Fonts/Montserrat-ExtraBold.ttf" />
    <BundleResource Include="..\..\windows\IdMaker.App\Fonts\Poppins-Bold.ttf" LogicalName="Fonts/Poppins-Bold.ttf" />
    <BundleResource Include="..\..\windows\IdMaker.Vision\Models\modnet.onnx" LogicalName="Models/modnet.onnx" />
    <!-- Made from assets/id-maker-logo.png by mac/make-icon.sh, which needs a Mac; packaging runs it first. -->
    <BundleResource Include="AppIcon.icns" Condition="Exists('AppIcon.icns')" />
  </ItemGroup>

  <!-- The window tests drive the real window against a pretend register.
       They and the pretend register are compiled in only when asked for
       (-p:WindowTest=true, as CI does); a release carries neither. -->
  <ItemGroup Condition="'$(WindowTest)' != 'true'">
    <Compile Remove="Tests\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WindowTest)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowTest)' == 'true'">
    <Compile Include="..\..\windows\IdMaker.Tests\FakeFirebase.cs" Link="Tests\FakeFirebase.cs" />
  </ItemGroup>

</Project>
