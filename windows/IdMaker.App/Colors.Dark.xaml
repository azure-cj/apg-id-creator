<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark mode.

      The company design system (the same as Alpha Premier Attendance):
      warm black surfaces, warm white text, gold as the single accent.
      Gold fills the one forward button and the current step; gold-soft
      outlines controls; gold marks section labels, table headings, links
      and the focus ring; coral is for errors. The signing screen is black
      in both modes.

      Two tiers. The Palette.* colours are raw values; the Color.* brushes
      are named for what they are for, and the window only ever uses those.
      Colors.Light.xaml and Colors.Dark.xaml define exactly the same names:
      ThemeManager swaps one for the other when Windows changes mode, and
      every control that refers to a brush with DynamicResource follows.

      The printed card is not drawn from any of these. Its colours come
      from the card artwork, and do not change with the window.
    -->
    <Color x:Key="Palette.Page">#090A09</Color>
    <Color x:Key="Palette.Panel">#151613</Color>
    <Color x:Key="Palette.Field">#0F100E</Color>
    <Color x:Key="Palette.Ink">#F6F2E9</Color>
    <Color x:Key="Palette.InkMuted">#AAA79E</Color>
    <Color x:Key="Palette.Rule">#3A3426</Color>
    <Color x:Key="Palette.RuleStrong">#8D753E</Color>
    <Color x:Key="Palette.Black">#000000</Color>
    <Color x:Key="Palette.Charcoal">#1F1F1F</Color>
    <Color x:Key="Palette.Smoke">#E0E0E0</Color>
    <Color x:Key="Palette.Ash">#A8A8A8</Color>
    <Color x:Key="Palette.Gold">#D4AF37</Color>
    <Color x:Key="Palette.GoldBright">#E1C477</Color>
    <Color x:Key="Palette.InkOnGold">#090A09</Color>
    <Color x:Key="Palette.Red">#EFAA92</Color>
    <Color x:Key="Palette.Amber">#E1C477</Color>
    <Color x:Key="Palette.Hover">#1D1C17</Color>
    <Color x:Key="Palette.Active">#25231C</Color>
    <Color x:Key="Palette.InkHover">#FFFFFF</Color>
    <Color x:Key="Palette.OnInk">#090A09</Color>
    <Color x:Key="Palette.Stage">#11120F</Color>
    <Color x:Key="Palette.StageRaised">#1D1C17</Color>
    <Color x:Key="Palette.StageMuted">#AAA79E</Color>
    <Color x:Key="Palette.CardEdge">#3A3426</Color>
    <Color x:Key="Palette.Thumb">#8D753E</Color>
    <Color x:Key="Palette.GoldTint">#2A2416</Color>
    <Color x:Key="Palette.GoldRule">#66532D</Color>
    <Color x:Key="Palette.FocusRing">#E1C477</Color>
    <Color x:Key="Palette.GoldText">#C6A254</Color>
    <Color x:Key="Palette.GoldLink">#E1C477</Color>
    <Color x:Key="Palette.GlassEdge">#37321F</Color>
    <Color x:Key="Palette.Success">#98D2A8</Color>
    <Color x:Key="Palette.ThumbHover">#A88A4A</Color>

    <SolidColorBrush x:Key="Color.Bg" Color="{StaticResource Palette.Page}" />
    <SolidColorBrush x:Key="Color.Surface" Color="{StaticResource Palette.Panel}" />
    <SolidColorBrush x:Key="Color.Field" Color="{StaticResource Palette.Field}" />  <!-- inside a text box or list -->
    <SolidColorBrush x:Key="Color.Text" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Color.TextMuted" Color="{StaticResource Palette.InkMuted}" />
    <SolidColorBrush x:Key="Color.Line" Color="{StaticResource Palette.Rule}" />  <!-- dividers and panel edges -->
    <SolidColorBrush x:Key="Color.ControlBorder" Color="{StaticResource Palette.RuleStrong}" />  <!-- edges of things you can use: 3:1 or more against Surface -->
    <SolidColorBrush x:Key="Color.Tray" Color="{StaticResource Palette.Black}" />  <!-- the signing screen, the logo tile and the map labels: black in both modes -->
    <SolidColorBrush x:Key="Color.TrayRaised" Color="{StaticResource Palette.Charcoal}" />
    <SolidColorBrush x:Key="Color.TrayInk" Color="{StaticResource Palette.Smoke}" />
    <SolidColorBrush x:Key="Color.TrayMuted" Color="{StaticResource Palette.Ash}" />
    <SolidColorBrush x:Key="Color.AccentSolid" Color="{StaticResource Palette.Gold}" />  <!-- gold for fills -->
    <SolidColorBrush x:Key="Color.AccentSolidHover" Color="{StaticResource Palette.GoldBright}" />
    <SolidColorBrush x:Key="Color.OnAccent" Color="{StaticResource Palette.InkOnGold}" />  <!-- text on a gold fill -->
    <SolidColorBrush x:Key="Color.Hover" Color="{StaticResource Palette.Hover}" />  <!-- under the pointer: one tone step, no colour -->
    <SolidColorBrush x:Key="Color.Active" Color="{StaticResource Palette.Active}" />  <!-- the open tool, the highlighted row -->
    <SolidColorBrush x:Key="Color.Strong" Color="{StaticResource Palette.Ink}" />  <!-- a chosen option, a ticked box: the text colour as a fill -->
    <SolidColorBrush x:Key="Color.StrongHover" Color="{StaticResource Palette.InkHover}" />
    <SolidColorBrush x:Key="Color.OnStrong" Color="{StaticResource Palette.OnInk}" />
    <SolidColorBrush x:Key="Color.Focus" Color="{StaticResource Palette.FocusRing}" />  <!-- the focus ring: bright gold (company design system) -->
    <SolidColorBrush x:Key="Color.Stage" Color="{StaticResource Palette.Stage}" />  <!-- what the card preview sits on: one step from the page -->
    <SolidColorBrush x:Key="Color.StageRaised" Color="{StaticResource Palette.StageRaised}" />
    <SolidColorBrush x:Key="Color.StageInk" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Color.StageMuted" Color="{StaticResource Palette.StageMuted}" />
    <SolidColorBrush x:Key="Color.CardEdge" Color="{StaticResource Palette.CardEdge}" />  <!-- a hairline round the card, so its edge shows on the stage -->
    <SolidColorBrush x:Key="Color.Danger" Color="{StaticResource Palette.Red}" />
    <SolidColorBrush x:Key="Color.Warning" Color="{StaticResource Palette.Amber}" />
    <SolidColorBrush x:Key="Color.ScrollThumb" Color="{StaticResource Palette.Thumb}" />
    <SolidColorBrush x:Key="Color.ScrollThumbHover" Color="{StaticResource Palette.ThumbHover}" />
    <!-- the box an "i" note opens in: a pale wash of the brand gold, never a fill you press -->
    <SolidColorBrush x:Key="Color.NoteGold" Color="{StaticResource Palette.GoldTint}" />
    <SolidColorBrush x:Key="Color.NoteGoldLine" Color="{StaticResource Palette.GoldRule}" />
    <!-- done and ready: the company design system's success green -->
    <SolidColorBrush x:Key="Color.Success" Color="{StaticResource Palette.Success}" />
    <!-- gold in words: section labels and table headings (Kicker), links and other active words (Link) -->
    <SolidColorBrush x:Key="Color.Kicker" Color="{StaticResource Palette.GoldText}" />
    <SolidColorBrush x:Key="Color.Link" Color="{StaticResource Palette.GoldLink}" />
    <!-- the edge of a raised (glass) panel: gold at a fifth of its strength over the panel -->
    <SolidColorBrush x:Key="Color.GlassEdge" Color="{StaticResource Palette.GlassEdge}" />
</ResourceDictionary>
