<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      How the window's controls look. Every colour here is a DynamicResource
      naming a Color.* brush from Colors.Light.xaml or Colors.Dark.xaml, so
      that when Windows switches between light and dark the whole window
      follows without being reopened. A StaticResource would keep the
      colour it found first; a test fails if one creeps in.

      Every control the window uses is styled here, including the ones WPF
      would otherwise draw in its own fixed light grey: lists, tick boxes,
      the fold-out sections, the slider, scroll bars, menus and tooltips.
    -->

    <!-- A focus ring you can see in either mode: two pixels of the text colour, set off from the control. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource Color.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Type (company design system): Poppins for everything you read, Orbitron
      only for the product's name and headings. Built into the program
      (UiFonts), so nothing has to be installed. Four sizes (13, 14, 16, 20),
      nothing smaller than 13.
    -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/AlphaPremierIdMaker;component/UiFonts/#Poppins</FontFamily>
    <FontFamily x:Key="Font.Display">pack://application:,,,/AlphaPremierIdMaker;component/UiFonts/#Orbitron</FontFamily>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TextMuted}" />
    </Style>
    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Color.Danger}" />
        <Style.Triggers>
            <!-- with nothing to say it takes no line of its own; its margins keep the fields apart -->
            <Trigger Property="Text" Value="">
                <Setter Property="Height" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource Text.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
    </Style>
    <!-- A section's label and a table's headings: small, in gold. -->
    <Style x:Key="Text.Kicker" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Kicker}" />
    </Style>
    <!-- Closes a header standing on the page: one gold hairline that fades out to the right. -->
    <Style x:Key="Rule.GoldFade" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#C6A254" Offset="0" />
                    <GradientStop Color="#00C6A254" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons. Every one is at least 40 high, so it can be hit without aiming. -->
    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- felt under the finger: no animation, the press just shows -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one gold button: whatever moves the job forward (Next, Save the PDF). One per screen. -->
    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Color.AccentSolid}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.AccentSolid}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Color.AccentSolidHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Color.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The main action of a tool in the drawer (Make the batch, Keep this map): the text colour as a fill, so Next stays the only gold. -->
    <!--
      A step's or a tool's own main action (Choose a photo, Make the batch): a
      gold outline, firmer than an ordinary button's, so the one gold fill on
      screen stays the button that moves the job forward.
    -->
    <Style x:Key="Button.Strong" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Kicker}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Color.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Link}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- On the black signing screen. -->
    <Style x:Key="Button.OnTray" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Color.TrayRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.TrayMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TrayInk}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Color.TrayInk}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Reads as a link, but is a button: it does something rather than going somewhere. -->
    <Style x:Key="Button.Link" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Link}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <!-- the rule under the words is what says "this can be pressed" -->
                        <Border x:Name="Rule" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,1" VerticalAlignment="Center">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rule" Property="BorderBrush" Value="{DynamicResource Color.Link}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same link on black (a tool's header band): light words, a grey rule that turns light under the pointer. -->
    <Style x:Key="Button.LinkOnTray" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.TrayMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TrayInk}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border x:Name="Rule" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,1" VerticalAlignment="Center">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rule" Property="BorderBrush" Value="{DynamicResource Color.TrayInk}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.TrayRaised}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A small "i" beside a short line: the detail that is worth having but not
      worth reading every time, shown on hover or when it has the keyboard.
      Its words are its ToolTip, and the same words are its HelpText for a
      screen reader. The ring is the text colour, like everything that is not
      the one gold button; a 32-pixel square round it is what the pointer hits.
    -->
    <Style x:Key="Button.Info" TargetType="ButtonBase">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2,-8,0,-8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="AutomationProperties.Name" Value="More information" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                BorderBrush="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="i" FontSize="13" FontWeight="Bold" FontStyle="Italic" FontFamily="Georgia"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,1,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One of the four tools in the rail. Checked while its drawer is open. -->
    <Style x:Key="Button.Rail" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </Trigger>
                        <!-- the open tool: a grey step and heavier words, no colour -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Active}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice among a few: job titles, card side, print layout. A real radio button underneath, so arrow keys work. -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{DynamicResource Color.Surface}" BorderBrush="{DynamicResource Color.ControlBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- the tick says "chosen" without relying on colour -->
                            <Path x:Name="Tick" Data="M1,6 L5,10 L12,2" Stroke="{DynamicResource Color.OnStrong}" StrokeThickness="2"
                                  Width="13" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Strong}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Color.Strong}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnStrong}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One choice of a switch (Appearance in the rail): an icon, muted until chosen. The thumb behind it is drawn by the window. -->
    <Style x:Key="Switch.Option" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
                        </Trigger>
                        <!-- on the gold thumb: the dark of the gold button's own words -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      An outlined switch (the print layout on the check step), in the manner of
      the warning mark: a thin gold-soft outline round both choices, and the
      chosen one marked by a gold outline over a faint gold wash, its words in
      gold. No solid fill, so it does not compete with the gold button below.
    -->
    <Style x:Key="Switch.OptionOutline" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Link}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A flip switch (Front / Back above the card): the whole thing is one
      toggle, its track and knob drawn in the markup inside it. At least 40
      high, so it is hit without aiming; the focus ring is the usual one.
    -->
    <Style x:Key="Switch.Flip" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track a switch's options sit in: a full pill, a tone step from what it sits on. -->
    <Style x:Key="Switch.Track" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.Active}" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!--
      The thumb that slides to the chosen option: gold, with a soft vertical
      sheen and a thin light line along its top (Switch.ThumbSheen, inside it),
      so it reads as slightly glassy rather than flat or bevelled.
    -->
    <Style x:Key="Switch.Thumb" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.AccentSolid}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="Switch.ThumbSheen" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="#8CFFFFFF" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                    <GradientStop Color="#1A000000" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Front or Back, above the card. -->
    <Style x:Key="Chip.Side" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="MinWidth" Value="76" />
    </Style>

    <!--
      One step of the five, in the bar above the form: a rule and a word. The
      window sets the rule's colour and thickness (thick ink for a finished
      step, thick gold for the one you are on, a hairline for those to come),
      so the state shows in shape as well as colour.
    -->
    <Style x:Key="Step" TargetType="ButtonBase">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Color.TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.ControlBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Chrome" Background="Transparent">
                        <!-- every rule sits in the same three pixels, so the words below line up -->
                        <Border Height="3" VerticalAlignment="Top">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" VerticalAlignment="Top" />
                        </Border>
                        <!-- centred under its rule, so the five names sit evenly along the bar -->
                        <ContentPresenter Margin="0,11,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Color.Field}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Color.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Color.Focus}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <!-- no margin here: a text box hands its Padding to this part itself, and a margin would count it twice -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- under the pointer: one tone step, like every other control; a red edge stays red -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                                <Condition Property="IsReadOnly" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Color.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The password for the shared register. The same field as Input: WPF's own stays light grey in dark mode. -->
    <Style x:Key="Input.Password" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Color.Field}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Color.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Color.Focus}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Color.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text box of several lines: the photo prompt. -->
    <Style x:Key="Input.Multiline" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A drop-down list. Drawn here, not by WPF, so it is dark in dark mode too. -->
    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8,36,8" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{DynamicResource Color.Field}" BorderBrush="{DynamicResource Color.ControlBorder}"
                                            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M0,0 L5,5 L10,0"
                                              Stroke="{DynamicResource Color.TextMuted}" StrokeThickness="1.6" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Color.Text}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Color.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                            <ContentPresenter.Resources>
                                <!-- a choice longer than the box ends in "…" rather than being cut mid-word -->
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <!--
                          The list slides open the way Windows' own lists do, and not at all when
                          Windows' animation effects are off. It is exactly as wide as the box it
                          drops from, so a long choice wraps instead of running past the panel,
                          and it sits on the page tone, a step from the white of the form.
                        -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Color.Bg}" BorderBrush="{DynamicResource Color.ControlBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One choice in a drop-down list. Implicit, so the lists' own items pick it up. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <!-- a long choice wraps inside the list rather than widening it -->
                        <ContentPresenter VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="18" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- the chosen row is lifted to the panel's white; the one under the pointer is a tone darker than the list -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Color.Surface}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Color.Active}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tick box. -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="4" BorderThickness="1.5" VerticalAlignment="Center"
                                Background="{DynamicResource Color.Field}" BorderBrush="{DynamicResource Color.ControlBorder}">
                            <Path x:Name="Tick" Data="M1,6 L5,10 L12,2" Stroke="{DynamicResource Color.OnStrong}" StrokeThickness="2.2"
                                  Width="13" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Color.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Color.Strong}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Color.Strong}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A section that folds open: "Move or resize it", "If the cut-out looks wrong". -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Cursor="Hand" MinHeight="40" FocusVisualStyle="{StaticResource FocusRing}"
                                      Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Chevron" Data="M0,0 L5,5 L0,10" Stroke="{DynamicResource Color.TextMuted}" StrokeThickness="1.8"
                                                  VerticalAlignment="Center" Width="7" Height="11" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two halves of the slider's track: the text colour up to the thumb, a plain line after it. -->
    <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The size slider on the photo step. -->
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderTrackPart}" Background="{DynamicResource Color.Strong}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderTrackPart}" Background="{DynamicResource Color.ControlBorder}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="20" Height="20">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{DynamicResource Color.Strong}" Stroke="{DynamicResource Color.Surface}" StrokeThickness="2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: thin, rounded, and the right shade in either mode. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" CornerRadius="4" Background="{DynamicResource Color.ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Color.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Color.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" MinHeight="28" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinWidth="28" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips and the right-click menu on a remembered job title. A tooltip's words wrap at a readable width. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Color.Surface}" BorderBrush="{DynamicResource Color.ControlBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="18" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      What an "i" mark (and a warning mark) opens: its words in a box of their
      own, broken into short lines, on a pale wash of the brand gold with a
      gold rule, so it reads as a note and not as part of the form. The wash
      is the only gold outside Next and the current step, and it is never
      something to press. MainWindow.GiveInfoMarksTheirWords puts it on.
    -->
    <Style x:Key="ToolTip.Note" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Color.NoteGold}" BorderBrush="{DynamicResource Color.NoteGoldLine}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" MaxWidth="300">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="19" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A warning worth a look but not worth a paragraph: an amber triangle and
      a few words, with the whole of it in a note box on hover or with the
      keyboard. A real button, so Tab reaches it and a screen reader reads it.
    -->
    <Style x:Key="Button.Warn" TargetType="ButtonBase">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="{DynamicResource Color.Warning}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="16" VerticalAlignment="Center">
                                <Path Data="M9,1.5 L17,15 L1,15 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Color.Surface}" BorderBrush="{DynamicResource Color.ControlBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="12,8" MinHeight="36">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Color.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The gold itself at low opacity: the ground of a list in a tool (the Batch
      files and results, the Issued IDs table). A layer of its own, under the
      list, so only the ground is see-through and the words stay solid. Faint
      enough that it never reads as the gold button; ThemeTests holds both.
    -->
    <Style x:Key="Panel.GoldWash" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.AccentSolid}" />
        <Setter Property="Opacity" Value="0.16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--
      A panel on the page: the drawer and the form. Raised like glass: a gold
      edge at a fifth of its strength, a faint light line along the top
      (Panel.Highlight, laid over it) and a deep soft shadow under it
      (Panel.Shadow, a layer of its own behind it, so the words on the panel
      keep their sharpest drawing). Panels are 8 round, the controls in them
      6, the marks in those 4.
    -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Panel.Shadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.3" RenderingBias="Performance" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Panel.Highlight" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#33FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
