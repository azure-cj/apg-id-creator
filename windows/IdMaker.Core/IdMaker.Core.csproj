<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Which Firebase project the shared register is in is not written in the
       source. The release build sets IDMAKER_FIREBASE_PROJECT_ID and
       IDMAKER_FIREBASE_API_KEY from repository secrets; without both the app
       has no shared register. Read by CardConfig.Register. -->
  <ItemGroup Condition="'$(IDMAKER_FIREBASE_PROJECT_ID)' != '' And '$(IDMAKER_FIREBASE_API_KEY)' != ''">
    <AssemblyMetadata Include="FirebaseProjectId" Value="$(IDMAKER_FIREBASE_PROJECT_ID)" />
    <AssemblyMetadata Include="FirebaseApiKey" Value="$(IDMAKER_FIREBASE_API_KEY)" />
  </ItemGroup>

</Project>
